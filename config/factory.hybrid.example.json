{
  "version": 1,
  "budget": {
    "max_agent_runs": 35,
    "max_total_tokens": 8400000,
    "max_run_tokens": 240000,
    "max_wall_seconds": 21600
  },
  "max_rounds": 5,
  "timeout_seconds": 900,
  "independent_review_required": true,
  "max_review_bytes": 1048576,
  "max_context_bytes": 2097152,
  "checks": [
    [
      "make",
      "verify"
    ]
  ],
  "ci": [
    [
      "make",
      "lint"
    ]
  ],
  "profiles": {
    "developer": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high",
      "transport": {
        "type": "cli_proxy",
        "endpoint": "http://127.0.0.1:18317/v1",
        "configured_provider": "cli_proxy_api",
        "policy_file": "/absolute/private-factory-proxy/policy.json"
      }
    },
    "reviewer": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high",
      "transport": {
        "type": "official"
      },
      "codex_home": "/absolute/private-official-codex-home"
    },
    "second_reviewer": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "transport": {
        "type": "direct"
      },
      "max_output_tokens": 16384,
      "token_file": "/absolute/path/to/owner-only-deepseek-token"
    }
  }
}
